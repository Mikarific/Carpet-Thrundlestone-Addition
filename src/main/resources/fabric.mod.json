{
  "schemaVersion": 1,
  "id": "carpet-thrundlestone-addition",
  "version": "${version}",
  "name": "Carpet Thrundlestone Addition",
  "description": "A Carpet mod (fabric-carpet) extension for performing and testing Thrundlestone.",
  "authors": [
    "Mikarific"
  ],
  "contact": {
    "repo": "https://github.com/mikarific/Carpet-Thrundlestone-Addition"
  },
  "license": "MIT",
  "icon": "assets/carpet-thrundlestone-addition/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mikarific.carpetthrundlestoneaddition.CarpetThrundlestoneAddition"
    ]
  },
  "mixins": [
    "carpet-thrundlestone-addition.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "carpet": "*"
  },
  "custom": {
    "modmenu:parent": "carpet"
  },
  "accessWidener": "carpet-thrundlestone-addition.accesswidener"
}
